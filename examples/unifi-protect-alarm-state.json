[
  {
    "id": "flow-protect-alarm-poll",
    "type": "tab",
    "label": "Protect Alarm State",
    "disabled": false,
    "info": "Select your existing Protect connection and NVR in the Read Alarm State node. Polls every 60 seconds and after deployment."
  },
  {
    "id": "inject-protect-alarm-poll",
    "type": "inject",
    "z": "flow-protect-alarm-poll",
    "name": "Poll every 60 seconds",
    "props": [],
    "repeat": "60",
    "crontab": "",
    "once": true,
    "onceDelay": 5,
    "topic": "",
    "x": 170,
    "y": 120,
    "wires": [
      [
        "read-protect-alarm-state"
      ]
    ]
  },
  {
    "id": "read-protect-alarm-state",
    "type": "unifi-protect-device",
    "z": "flow-protect-alarm-poll",
    "name": "Read Alarm State (NVR)",
    "server": "",
    "deviceType": "nvr",
    "deviceId": "",
    "deviceName": "",
    "inputs": 1,
    "capability": "getDetails",
    "capabilityConfig": "{}",
    "emitStartupAndUndefined": false,
    "autoEmit": false,
    "autoEmitInterval": 60,
    "x": 440,
    "y": 120,
    "wires": [
      [
        "extract-protect-alarm-status"
      ],
      [
        "debug-protect-alarm-error"
      ]
    ]
  },
  {
    "id": "extract-protect-alarm-status",
    "type": "function",
    "z": "flow-protect-alarm-poll",
    "name": "Extract armMode.status",
    "func": "const armMode = msg.payload && msg.payload.armMode;\nif (!armMode || typeof armMode.status !== 'string') {\n    node.error('NVR response does not contain armMode.status. Check Protect version and the full response.', msg);\n    return [null, msg];\n}\nmsg.armMode = armMode;\nmsg.payload = armMode.status;\nreturn [msg, null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 720,
    "y": 100,
    "wires": [
      [
        "debug-protect-alarm-status"
      ],
      [
        "debug-protect-alarm-error"
      ]
    ]
  },
  {
    "id": "debug-protect-alarm-status",
    "type": "debug",
    "z": "flow-protect-alarm-poll",
    "name": "Current alarm status",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 990,
    "y": 100,
    "wires": []
  },
  {
    "id": "debug-protect-alarm-error",
    "type": "debug",
    "z": "flow-protect-alarm-poll",
    "name": "Error / missing alarm state",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "x": 730,
    "y": 200,
    "wires": []
  }
]
